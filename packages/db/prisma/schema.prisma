generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum PlatformRole {
  SUPER_ADMIN
  ADMIN_MODERATOR
  USER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  COMMENTER
  VIEWER
  GUEST
}

enum NodeType {
  FRAME
  RECTANGLE
  ELLIPSE
  LINE
  POLYGON
  STAR
  VECTOR
  TEXT
  IMAGE
  ICON
  GROUP
  COMPONENT
  INSTANCE
}

enum StyleType {
  COLOR
  TEXT
  EFFECT
  SPACING
}

enum AssetType {
  IMAGE
  FONT
  ICON
  EXPORT
}

enum ShareResourceType {
  FILE
  PROTOTYPE
}

enum TemplateStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum DeployEnvironment {
  PREVIEW
  PRODUCTION
}

enum DeployStatus {
  QUEUED
  BUILDING
  DEPLOYED
  FAILED
  ROLLED_BACK
}

enum DomainStatus {
  PENDING_DNS
  VERIFIED
  SSL_ACTIVE
  FAILED
}

enum PaymentProvider {
  STRIPE
  MIDTRANS
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  emailVerified    DateTime?
  name             String?
  username         String?      @unique
  avatarUrl        String?
  bio              String?
  passwordHash     String?
  platformRole     PlatformRole @default(USER)
  locale           String       @default("id")
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret  String?
  onboardingGoal   String?
  lastActiveAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]      @relation("WorkspaceOwner")
  memberships       Membership[]
  createdFiles      File[]           @relation("FileCreator")
  fileVersions      FileVersion[]
  uploadedAssets    Asset[]
  authoredComments  Comment[]        @relation("CommentAuthor")
  resolvedComments  Comment[]        @relation("CommentResolver")
  authoredTemplates Template[]       @relation("TemplateAuthor")
  reviewedTemplates Template[]       @relation("TemplateReviewer")
  templateLikes     TemplateLike[]
  submittedReports  TemplateReport[] @relation("ReportReporter")
  reviewedReports   TemplateReport[] @relation("ReportReviewer")
  deployments       Deployment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]

  @@index([platformRole])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// WORKSPACES, RBAC & PROJECTS
// ============================================================================

model Workspace {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  ownerId     String
  storageUsed BigInt  @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner         User           @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships   Membership[]
  projects      Project[]
  files         File[]
  components    Component[]
  styles        Style[]
  assets        Asset[]
  templates     Template[]
  deployments   Deployment[]
  domains       Domain[]
  envVars       EnvVar[]
  subscriptions Subscription[]
  notifications Notification[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]

  @@index([ownerId])
  @@index([deletedAt])
}

model Membership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  invitedById String?
  joinedAt    DateTime      @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@index([deletedAt])
}

model Project {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  color       String  @default("#6C5CE7")
  isArchived  Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files       File[]
  deployments Deployment[]
  domains     Domain[]
  envVars     EnvVar[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, deletedAt])
}

// ============================================================================
// DESIGN EDITOR (FILES, PAGES, NODES, COMPONENTS, STYLES, ASSETS)
// ============================================================================

model File {
  id           String    @id @default(cuid())
  workspaceId  String
  projectId    String?
  createdById  String
  name         String
  slug         String?
  description  String?
  thumbnailUrl String?
  isFavorite   Boolean   @default(false)
  isDraft      Boolean   @default(true)
  yjsDocument  Bytes?
  lastEditedAt DateTime  @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("FileCreator", fields: [createdById], references: [id])
  pages       Page[]
  versions    FileVersion[]
  shareLinks  ShareLink[]
  components  Component[]
  styles      Style[]
  assets      Asset[]
  comments    Comment[]
  prototypes  Prototype[]
  templates   Template[]
  deployments Deployment[]

  @@index([workspaceId, deletedAt])
  @@index([projectId, deletedAt])
  @@index([createdById])
  @@index([lastEditedAt])
}

model FileVersion {
  id          String  @id @default(cuid())
  fileId      String
  createdById String
  name        String
  description String?
  snapshot    Json

  createdAt DateTime @default(now())

  file      File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([fileId, createdAt])
}

model ShareLink {
  id           String            @id @default(cuid())
  fileId       String
  resourceType ShareResourceType @default(FILE)
  token        String            @unique
  role         WorkspaceRole     @default(VIEWER)
  passwordHash String?
  expiresAt    DateTime?
  isActive     Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([token])
}

model Page {
  id              String  @id @default(cuid())
  fileId          String
  name            String  @default("Page 1")
  order           Int     @default(0)
  backgroundColor String  @default("#F5F6FA")
  viewport        Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  file       File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  nodes      Node[]      @relation("PageNodes")
  comments   Comment[]
  prototypes Prototype[] @relation("PrototypeStartPage")

  @@index([fileId, order])
  @@index([deletedAt])
}

model Node {
  id          String   @id @default(cuid())
  pageId      String
  parentId    String?
  componentId String?
  type        NodeType
  name        String
  order       Int      @default(0)
  x           Float    @default(0)
  y           Float    @default(0)
  width       Float    @default(100)
  height      Float    @default(100)
  rotation    Float    @default(0)
  opacity     Float    @default(1)
  visible     Boolean  @default(true)
  locked      Boolean  @default(false)
  props       Json     @default("{}")
  overrides   Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  page      Page       @relation("PageNodes", fields: [pageId], references: [id], onDelete: Cascade)
  parent    Node?      @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Node[]     @relation("NodeHierarchy")
  component Component? @relation("NodeComponent", fields: [componentId], references: [id], onDelete: SetNull)

  @@index([pageId, parentId, order])
  @@index([componentId])
  @@index([deletedAt])
}

model Component {
  id          String  @id @default(cuid())
  workspaceId String
  fileId      String
  rootNodeId  String?
  name        String
  description String?
  category    String?
  variants    Json    @default("[]")
  definition  Json    @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  instances Node[]    @relation("NodeComponent")

  @@index([workspaceId, deletedAt])
  @@index([fileId, deletedAt])
}

model Style {
  id          String    @id @default(cuid())
  workspaceId String
  fileId      String?
  type        StyleType
  name        String
  tokenName   String?
  description String?
  value       Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file      File?     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, deletedAt])
  @@index([fileId])
}

model Asset {
  id           String    @id @default(cuid())
  workspaceId  String
  fileId       String?
  uploadedById String
  type         AssetType
  name         String
  storageKey   String    @unique
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  metadata     Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file       File?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([workspaceId, type, deletedAt])
  @@index([fileId])
}

// ============================================================================
// COLLABORATION & PROTOTYPING
// ============================================================================

model Comment {
  id           String    @id @default(cuid())
  fileId       String
  pageId       String?
  parentId     String?
  authorId     String
  nodeId       String?
  posX         Float?
  posY         Float?
  body         String    @db.Text
  mentions     Json      @default("[]")
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  file       File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  page       Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")
  author     User      @relation("CommentAuthor", fields: [authorId], references: [id])
  resolvedBy User?     @relation("CommentResolver", fields: [resolvedById], references: [id])

  @@index([fileId, pageId, deletedAt])
  @@index([parentId])
  @@index([authorId])
}

model Prototype {
  id           String  @id @default(cuid())
  fileId       String
  startPageId  String?
  startFrameId String?
  name         String  @default("Default Prototype")
  devicePreset String  @default("desktop")
  flows        Json    @default("[]")
  interactions Json    @default("[]")
  shareSlug    String  @unique
  passwordHash String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  file      File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  startPage Page? @relation("PrototypeStartPage", fields: [startPageId], references: [id], onDelete: SetNull)

  @@index([fileId, deletedAt])
}

// ============================================================================
// TEMPLATE MARKETPLACE & MODERATION
// ============================================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  icon        String?
  order       Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  templates Template[]

  @@index([order])
  @@index([deletedAt])
}

model Template {
  id             String         @id @default(cuid())
  fileId         String
  workspaceId    String
  authorId       String
  categoryId     String
  reviewedById   String?
  title          String
  slug           String         @unique
  description    String         @db.Text
  tags           String[]       @default([])
  thumbnailUrl   String?
  license        String         @default("MIT")
  isFree         Boolean        @default(true)
  priceCents     Int            @default(0)
  status         TemplateStatus @default(PENDING_REVIEW)
  rejectionNote  String?
  featuredAt     DateTime?
  publishedAt    DateTime?
  downloadsCount Int            @default(0)
  likesCount     Int            @default(0)
  snapshot       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  file       File             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author     User             @relation("TemplateAuthor", fields: [authorId], references: [id])
  category   Category         @relation(fields: [categoryId], references: [id])
  reviewedBy User?            @relation("TemplateReviewer", fields: [reviewedById], references: [id])
  likes      TemplateLike[]
  reports    TemplateReport[]

  @@index([status, featuredAt, deletedAt])
  @@index([categoryId, status])
  @@index([authorId])
  @@index([downloadsCount])
  @@index([likesCount])
}

model TemplateLike {
  id         String @id @default(cuid())
  templateId String
  userId     String

  createdAt DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([userId])
}

model TemplateReport {
  id           String       @id @default(cuid())
  templateId   String
  reporterId   String
  reviewedById String?
  reason       String
  details      String?      @db.Text
  status       ReportStatus @default(OPEN)
  resolution   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id])
  reviewedBy User?    @relation("ReportReviewer", fields: [reviewedById], references: [id])

  @@index([templateId, status])
  @@index([status])
}

// ============================================================================
// DEPLOY ENGINE (DEPLOYMENTS, DOMAINS, ENV VARS)
// ============================================================================

model Deployment {
  id             String            @id @default(cuid())
  workspaceId    String
  projectId      String
  fileId         String
  triggeredById  String
  environment    DeployEnvironment @default(PREVIEW)
  status         DeployStatus      @default(QUEUED)
  version        Int               @default(1)
  subdomain      String
  url            String?
  artifactKey    String?
  buildLogs      String?           @db.Text
  seoConfig      Json?
  redirects      Json?
  passwordHash   String?
  rollbackFromId String?
  deployedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  triggeredBy  User         @relation(fields: [triggeredById], references: [id])
  rollbackFrom Deployment?  @relation("DeploymentRollback", fields: [rollbackFromId], references: [id], onDelete: SetNull)
  rollbacks    Deployment[] @relation("DeploymentRollback")

  @@index([projectId, environment, createdAt])
  @@index([workspaceId, status])
  @@index([subdomain])
  @@index([deletedAt])
}

model Domain {
  id                String       @id @default(cuid())
  workspaceId       String
  projectId         String
  hostname          String       @unique
  isPrimary         Boolean      @default(false)
  status            DomainStatus @default(PENDING_DNS)
  verificationToken String
  verifiedAt        DateTime?
  sslExpiresAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId, deletedAt])
}

model EnvVar {
  id             String            @id @default(cuid())
  workspaceId    String
  projectId      String
  environment    DeployEnvironment @default(PRODUCTION)
  key            String
  encryptedValue String            @db.Text
  isSecret       Boolean           @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, environment, key])
  @@index([workspaceId])
}

// ============================================================================
// BILLING, NOTIFICATIONS, AUDIT, API KEYS, WEBHOOKS
// ============================================================================

model Plan {
  id                String  @id @default(cuid())
  code              String  @unique
  name              String
  description       String?
  priceMonthlyCents Int     @default(0)
  priceYearlyCents  Int     @default(0)
  currency          String  @default("USD")
  limits            Json    @default("{}")
  features          Json    @default("[]")
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  workspaceId        String
  planId             String
  provider           PaymentProvider    @default(MANUAL)
  externalId         String?
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([workspaceId, status])
  @@index([externalId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  type        String
  title       String
  body        String
  data        Json?
  readAt      DateTime?

  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id           String  @id @default(cuid())
  workspaceId  String?
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  keyPrefix   String
  keyHash     String    @unique
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId, deletedAt])
}

model Webhook {
  id              String    @id @default(cuid())
  workspaceId     String
  createdById     String
  url             String
  secretHash      String
  events          String[]  @default([])
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId, isActive, deletedAt])
}
