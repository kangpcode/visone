{
  "name": "visone",
  "version": "0.1.0",
  "private": true,
  "description": "VISONE — Design. Share. Deploy. All in one.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @visone/web dev",
    "dev:all": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:validate": "pnpm --filter @visone/db validate",
    "db:generate": "pnpm --filter @visone/db generate",
    "db:migrate": "pnpm --filter @visone/db migrate",
    "db:push": "pnpm --filter @visone/db push",
    "db:seed": "pnpm --filter @visone/db seed"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
