# ===========================================
# VISONE Platform — Environment Configuration
# ===========================================

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="VISONE"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEPLOY_ROOT_DOMAIN="visone.app"

# Database (PostgreSQL)
DATABASE_URL="postgresql://visone:visone_dev_password@localhost:5432/visone?schema=public"

# Redis (Cache, Rate Limit, BullMQ)
REDIS_URL="redis://localhost:6379"

# Realtime Collaboration (Hocuspocus / Yjs)
COLLAB_PORT="1234"
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"
COLLAB_INTERNAL_SECRET="change-me-collab-secret-min-32-chars"

# Authentication (Auth.js / NextAuth)
AUTH_SECRET="change-me-auth-secret-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@visone.app"

# Encryption key for EnvVar & Webhook secrets (32-byte hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# S3-Compatible Storage (MinIO in dev / Cloudflare R2 in prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="visone-assets"
S3_ACCESS_KEY="visone_minio"
S3_SECRET_KEY="visone_minio_secret"
S3_PUBLIC_URL="http://localhost:9000/visone-assets"

# Payment (Optional - Stripe / Midtrans)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# Monitoring (Optional)
SENTRY_DSN=""
